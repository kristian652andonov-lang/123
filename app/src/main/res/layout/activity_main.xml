<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_pastel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/intro_font"
            android:letterSpacing="0.08"
            android:shadowColor="#CCFFFFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:text="@string/title_text"
            android:textColor="@color/card_black"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            android:fontFamily="@font/intro_font"
            android:letterSpacing="0.04"
            android:shadowColor="#CCFFFFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="@string/hint_text"
            android:textColor="@color/card_black"
            android:textSize="16sp"
            android:alpha="0.75" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <com.kristian.doorac.NeonRingView
                android:id="@+id/doorRing"
                android:layout_width="294dp"
                android:layout_height="174dp" />

            <Button
                android:id="@+id/doorButton"
                android:layout_width="270dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_card_black"
                android:elevation="10dp"
                android:fontFamily="@font/intro_font"
                android:letterSpacing="0.06"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.kristian.doorac.NeonRingView
                android:id="@+id/acRing"
                android:layout_width="294dp"
                android:layout_height="174dp" />

            <Button
                android:id="@+id/acButton"
                android:layout_width="270dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_card_black"
                android:elevation="10dp"
                android:fontFamily="@font/intro_font"
                android:letterSpacing="0.06"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
