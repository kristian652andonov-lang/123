<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/black"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Провери преди да тръгнеш"
        android:textColor="@color/pastel_pink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="Докосни бутон, за да смениш статуса"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:alpha="0.7" />

    <Button
        android:id="@+id/doorButton"
        android:layout_width="260dp"
        android:layout_height="140dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_button_safe"
        android:elevation="8dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/acButton"
        android:layout_width="260dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_button_safe"
        android:elevation="8dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
